# Copy this file to `.env` and fill in the keys you actually use.
#   cp .env.example .env
# Never commit `.env` — it is already in .gitignore.

# Hugging Face 
# Required for gated models like meta-llama/Llama-3.1-8B-Instruct.
# Get a token at: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=hf_...

# OpenAI (optional) ─
# Only needed if you use OpenAIEmbeddings or RAGAS with the default judge.
OPENAI_API_KEY=

# Cohere (optional) 
# Only needed if you use CohereEmbeddings.
COHERE_API_KEY=

# Runtime tweaks 
HF_HOME=./.cache/huggingface
TOKENIZERS_PARALLELISM=false
